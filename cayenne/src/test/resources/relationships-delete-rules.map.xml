<?xml version="1.0" encoding="utf-8"?>
<dataMap xmlns="http://cayenne.apache.org/schema/15/dataMap"
	 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="http://cayenne.apache.org/schema/15/dataMap https://cayenne.apache.org/schema/15/dataMap.xsd"
	 defaultPackage="org.apache.cayenne.testdo.relationships_delete_rules">
	<dbEntity name="DELETE_RULE_FLATA">
		<dbAttribute name="FLATA_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
	</dbEntity>
	<dbEntity name="DELETE_RULE_FLATB">
		<dbAttribute name="FLATB_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
	</dbEntity>
	<dbEntity name="DELETE_RULE_JOIN">
		<dbAttribute name="FLATA_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="FLATB_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
	</dbEntity>
	<dbEntity name="DELETE_RULE_TEST1">
		<dbAttribute name="DEL_RULE_TEST1_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="TEST2_ID" type="INTEGER" mandatory="true"/>
	</dbEntity>
	<dbEntity name="DELETE_RULE_TEST2">
		<dbAttribute name="DEL_RULE_TEST2_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
	</dbEntity>
	<dbEntity name="DELETE_RULE_TEST3">
		<dbAttribute name="DELETE_RULE_TEST_3_FK" type="INTEGER"/>
		<dbAttribute name="DELETE_RULE_TEST_3_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
	</dbEntity>
	<objEntity name="DeleteRuleFlatA" className="org.apache.cayenne.testdo.relationships_delete_rules.DeleteRuleFlatA" dbEntityName="DELETE_RULE_FLATA"/>
	<objEntity name="DeleteRuleFlatB" className="org.apache.cayenne.testdo.relationships_delete_rules.DeleteRuleFlatB" dbEntityName="DELETE_RULE_FLATB"/>
	<objEntity name="DeleteRuleTest1" className="org.apache.cayenne.testdo.relationships_delete_rules.DeleteRuleTest1" dbEntityName="DELETE_RULE_TEST1"/>
	<objEntity name="DeleteRuleTest2" className="org.apache.cayenne.testdo.relationships_delete_rules.DeleteRuleTest2" dbEntityName="DELETE_RULE_TEST2"/>
	<objEntity name="DeleteRuleTest3" className="org.apache.cayenne.testdo.relationships_delete_rules.DeleteRuleTest3" dbEntityName="DELETE_RULE_TEST3"/>
	<dbRelationship name="joins" source="DELETE_RULE_FLATA" target="DELETE_RULE_JOIN" toMany="true">
		<dbAttributePair source="FLATA_ID" target="FLATA_ID"/>
	</dbRelationship>
	<dbRelationship name="joins" source="DELETE_RULE_FLATB" target="DELETE_RULE_JOIN" toMany="true">
		<dbAttributePair source="FLATB_ID" target="FLATB_ID"/>
	</dbRelationship>
	<dbRelationship name="flatA" source="DELETE_RULE_JOIN" target="DELETE_RULE_FLATA" foreignKey="true">
		<dbAttributePair source="FLATA_ID" target="FLATA_ID"/>
	</dbRelationship>
	<dbRelationship name="flatB" source="DELETE_RULE_JOIN" target="DELETE_RULE_FLATB" foreignKey="true">
		<dbAttributePair source="FLATB_ID" target="FLATB_ID"/>
	</dbRelationship>
	<dbRelationship name="deleteRuleTest3s" source="DELETE_RULE_TEST1" target="DELETE_RULE_TEST3" toMany="true">
		<dbAttributePair source="DEL_RULE_TEST1_ID" target="DELETE_RULE_TEST_3_FK"/>
	</dbRelationship>
	<dbRelationship name="test2" source="DELETE_RULE_TEST1" target="DELETE_RULE_TEST2" foreignKey="true">
		<dbAttributePair source="TEST2_ID" target="DEL_RULE_TEST2_ID"/>
	</dbRelationship>
	<dbRelationship name="deleteRuleTest3s" source="DELETE_RULE_TEST2" target="DELETE_RULE_TEST3" toMany="true">
		<dbAttributePair source="DEL_RULE_TEST2_ID" target="DELETE_RULE_TEST_3_FK"/>
	</dbRelationship>
	<dbRelationship name="test1s" source="DELETE_RULE_TEST2" target="DELETE_RULE_TEST1" toMany="true">
		<dbAttributePair source="DEL_RULE_TEST2_ID" target="TEST2_ID"/>
	</dbRelationship>
	<dbRelationship name="deleteRuleTest2" source="DELETE_RULE_TEST3" target="DELETE_RULE_TEST2" foreignKey="true">
		<dbAttributePair source="DELETE_RULE_TEST_3_FK" target="DEL_RULE_TEST2_ID"/>
	</dbRelationship>
	<objRelationship name="flatB" source="DeleteRuleFlatA" target="DeleteRuleFlatB" dbRelationshipPath="joins.flatB"/>
	<objRelationship name="untitledRel" source="DeleteRuleFlatB" target="DeleteRuleFlatA" dbRelationshipPath="joins.flatA"/>
	<objRelationship name="test2" source="DeleteRuleTest1" target="DeleteRuleTest2" deleteRule="deny" dbRelationshipPath="test2"/>
	<objRelationship name="deleteRuleTest3s" source="DeleteRuleTest2" target="DeleteRuleTest3" dbRelationshipPath="deleteRuleTest3s"/>
	<objRelationship name="test1s" source="DeleteRuleTest2" target="DeleteRuleTest1" deleteRule="nullify" dbRelationshipPath="test1s"/>
	<objRelationship name="deleteRuleTest2" source="DeleteRuleTest3" target="DeleteRuleTest2" dbRelationshipPath="deleteRuleTest2"/>
</dataMap>
