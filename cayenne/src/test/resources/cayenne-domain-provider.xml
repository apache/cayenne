<?xml version="1.0" encoding="utf-8"?>
<domain xmlns="http://cayenne.apache.org/schema/12/domain"
	 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="http://cayenne.apache.org/schema/12/domain https://cayenne.apache.org/schema/12/domain.xsd"
	 project-version="12">
	<property name="cayenne.DataDomain.validatingObjectsOnCommit" value="false"/>
	<map name="map-db1"/>
	<map name="map-db2"/>
	<node name="node1"
		 factory="org.apache.cayenne.configuration.runtime.XMLPoolingDataSourceFactory"
		 schema-update-strategy="org.apache.cayenne.access.dbsync.ThrowOnPartialOrCreateSchemaStrategy">
		<map-ref name="map-db1"/>
	</node>
	<node name="node2"
		 factory="org.apache.cayenne.configuration.runtime.XMLPoolingDataSourceFactory">
		<map-ref name="map-db2"/>
	</node>
</domain>
