<?xml version="1.0" encoding="utf-8"?>
<dataMap xmlns="http://cayenne.apache.org/schema/14/dataMap"
	 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="http://cayenne.apache.org/schema/14/dataMap https://cayenne.apache.org/schema/14/dataMap.xsd">
	<property name="defaultPackage" value="org.apache.cayenne.testdo.uuid"/>
	<dbEntity name="UUID_PK_ENTITY">
		<dbAttribute name="ID" type="VARCHAR" primaryKey="true" mandatory="true" length="100"/>
	</dbEntity>
	<dbEntity name="UUID_TEST">
		<dbAttribute name="ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="UUID" type="VARCHAR" length="100"/>
	</dbEntity>
	<dbEntity name="UUID_BIN_TEST">
		<dbAttribute name="ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="UUID" type="VARBINARY" length="16"/>
	</dbEntity>
	<objEntity name="UuidPkEntity" className="org.apache.cayenne.testdo.uuid.UuidPkEntity" dbEntityName="UUID_PK_ENTITY">
		<objAttribute name="id" type="java.util.UUID" dbAttributePath="ID"/>
	</objEntity>
	<objEntity name="UuidTestEntity" className="org.apache.cayenne.testdo.uuid.UuidTestEntity" dbEntityName="UUID_TEST">
		<objAttribute name="uuid" type="java.util.UUID" dbAttributePath="UUID"/>
	</objEntity>
	<objEntity name="UuidBinTestEntity" className="org.apache.cayenne.testdo.uuid.UuidBinTestEntity" dbEntityName="UUID_BIN_TEST">
		<objAttribute name="uuid" type="java.util.UUID" dbAttributePath="UUID"/>
	</objEntity>
</dataMap>
