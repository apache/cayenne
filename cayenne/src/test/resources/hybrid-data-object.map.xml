		<objAttribute name="strField" type="java.lang.String" dbAttributePath="STR_FIELD"/>
	</objEntity>
	<dbRelationship name="hybridEntities2" source="HYBRID_ENTITY_1" target="HYBRID_ENTITY_2" toMany="true">
		<dbAttributePair source="ID" target="HYBRID_ENTITY_1_ID"/>
	</dbRelationship>
	<dbRelationship name="hybridEntity1" source="HYBRID_ENTITY_2" target="HYBRID_ENTITY_1">
		<dbAttributePair source="HYBRID_ENTITY_1_ID" target="ID"/>
	</dbRelationship>
	<objRelationship name="hybridEntities2" source="HybridEntity1" target="HybridEntity2" deleteRule="deny" dbRelationshipPath="hybridEntities2"/>
	<objRelationship name="hybridEntity1" source="HybridEntity2" target="HybridEntity1" deleteRule="nullify" dbRelationshipPath="hybridEntity1"/>
</dataMap>
