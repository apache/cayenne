<?xml version="1.0" encoding="utf-8"?>
<dataMap xmlns="http://cayenne.apache.org/schema/14/dataMap"
	 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="http://cayenne.apache.org/schema/14/dataMap https://cayenne.apache.org/schema/14/dataMap.xsd">
	<property name="defaultPackage" value="org.apache.cayenne.testdo.relationships_many_to_many_join"/>
	<dbEntity name="X_AUTHOR">
		<dbAttribute name="AUTHOR_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="AUTHOR_NAME" type="VARCHAR" mandatory="true" length="50"/>
	</dbEntity>
	<dbEntity name="X_NODE">
		<dbAttribute name="NAME" type="VARCHAR" mandatory="true" length="255"/>
		<dbAttribute name="NODE_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="TYPE" type="INTEGER" mandatory="true"/>
	</dbEntity>
	<dbEntity name="X_NODE_JOIN">
		<dbAttribute name="CHILD_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="PARENT_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
	</dbEntity>
	<dbEntity name="X_SELF">
		<dbAttribute name="NAME" type="VARCHAR" mandatory="true" length="255"/>
		<dbAttribute name="SELF_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="TYPE" type="INTEGER" mandatory="true"/>
	</dbEntity>
	<dbEntity name="X_SELF_JOIN">
		<dbAttribute name="SELF_ID_FROM" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="SELF_ID_TO" type="INTEGER" primaryKey="true" mandatory="true"/>
	</dbEntity>
	<dbEntity name="X_SONG">
		<dbAttribute name="SONG_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="SONG_NAME" type="VARCHAR" mandatory="true" length="50"/>
	</dbEntity>
	<dbEntity name="X_SONGAUTHOR">
		<dbAttribute name="AUTHOR_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="SONG_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
	</dbEntity>
	<objEntity name="Author" className="org.apache.cayenne.testdo.relationships_many_to_many_join.Author" dbEntityName="X_AUTHOR">
		<objAttribute name="name" type="java.lang.String" dbAttributePath="AUTHOR_NAME"/>
	</objEntity>
	<objEntity name="Node" className="org.apache.cayenne.testdo.relationships_many_to_many_join.Node" dbEntityName="X_NODE">
		<qualifier><![CDATA[type = 1]]></qualifier>
		<objAttribute name="name" type="java.lang.String" dbAttributePath="NAME"/>
		<objAttribute name="type" type="int" dbAttributePath="TYPE"/>
	</objEntity>
	<objEntity name="NodeA" superEntityName="Node" className="org.apache.cayenne.testdo.relationships_many_to_many_join.NodeA">
		<qualifier><![CDATA[type = 2]]></qualifier>
	</objEntity>
	<objEntity name="NodeB" superEntityName="Node" className="org.apache.cayenne.testdo.relationships_many_to_many_join.NodeB">
		<qualifier><![CDATA[type = 3]]></qualifier>
	</objEntity>
	<objEntity name="SelfRelationship" className="org.apache.cayenne.testdo.relationships_many_to_many_join.SelfRelationship" dbEntityName="X_SELF">
		<qualifier><![CDATA[type = 1]]></qualifier>
		<objAttribute name="name" type="java.lang.String" dbAttributePath="NAME"/>
		<objAttribute name="type" type="int" dbAttributePath="TYPE"/>
	</objEntity>
	<objEntity name="SelfRelationshipSub" superEntityName="SelfRelationship" className="org.apache.cayenne.testdo.relationships_many_to_many_join.SelfRelationshipSub">
		<qualifier><![CDATA[type = 2]]></qualifier>
	</objEntity>
	<objEntity name="Song" className="org.apache.cayenne.testdo.relationships_many_to_many_join.Song" dbEntityName="X_SONG">
		<objAttribute name="name" type="java.lang.String" dbAttributePath="SONG_NAME"/>
	</objEntity>
	<dbRelationship name="songAuthor" source="X_AUTHOR" target="X_SONGAUTHOR" toDependentPK="true" toMany="true">
		<dbAttributePair source="AUTHOR_ID" target="AUTHOR_ID"/>
	</dbRelationship>
	<dbRelationship name="nodeJoinParent" source="X_NODE" target="X_NODE_JOIN" toDependentPK="true" toMany="true">
		<dbAttributePair source="NODE_ID" target="PARENT_ID"/>
	</dbRelationship>
	<dbRelationship name="nodeJoinChild" source="X_NODE" target="X_NODE_JOIN" toDependentPK="true" toMany="true">
		<dbAttributePair source="NODE_ID" target="CHILD_ID"/>
	</dbRelationship>
	<dbRelationship name="nodeParent" source="X_NODE_JOIN" target="X_NODE">
		<dbAttributePair source="PARENT_ID" target="NODE_ID"/>
	</dbRelationship>
	<dbRelationship name="nodeChild" source="X_NODE_JOIN" target="X_NODE">
		<dbAttributePair source="CHILD_ID" target="NODE_ID"/>
	</dbRelationship>
	<dbRelationship name="selfJoinFrom" source="X_SELF" target="X_SELF_JOIN" toDependentPK="true" toMany="true">
		<dbAttributePair source="SELF_ID" target="SELF_ID_FROM"/>
	</dbRelationship>
	<dbRelationship name="selfJoinTo" source="X_SELF" target="X_SELF_JOIN" toDependentPK="true" toMany="true">
		<dbAttributePair source="SELF_ID" target="SELF_ID_TO"/>
	</dbRelationship>
	<dbRelationship name="selfFrom" source="X_SELF_JOIN" target="X_SELF">
		<dbAttributePair source="SELF_ID_FROM" target="SELF_ID"/>
	</dbRelationship>
	<dbRelationship name="selfTo" source="X_SELF_JOIN" target="X_SELF">
		<dbAttributePair source="SELF_ID_TO" target="SELF_ID"/>
	</dbRelationship>
	<dbRelationship name="songAuthor" source="X_SONG" target="X_SONGAUTHOR" toDependentPK="true" toMany="true">
		<dbAttributePair source="SONG_ID" target="SONG_ID"/>
	</dbRelationship>
	<dbRelationship name="author" source="X_SONGAUTHOR" target="X_AUTHOR">
		<dbAttributePair source="AUTHOR_ID" target="AUTHOR_ID"/>
	</dbRelationship>
	<dbRelationship name="song" source="X_SONGAUTHOR" target="X_SONG">
		<dbAttributePair source="SONG_ID" target="SONG_ID"/>
	</dbRelationship>
	<objRelationship name="parents" source="Node" target="Node" deleteRule="nullify" dbRelationshipPath="nodeJoinChild.nodeParent"/>
	<objRelationship name="children" source="NodeA" target="Node" deleteRule="nullify" dbRelationshipPath="nodeJoinParent.nodeChild"/>
	<objRelationship name="selfChildren" source="SelfRelationship" target="SelfRelationshipSub" deleteRule="deny" dbRelationshipPath="selfJoinFrom.selfTo"/>
	<objRelationship name="selfParents" source="SelfRelationshipSub" target="SelfRelationship" deleteRule="nullify" dbRelationshipPath="selfJoinTo.selfFrom"/>
	<objRelationship name="authors" source="Song" target="Author" collectionType="java.util.Set" deleteRule="cascade" dbRelationshipPath="songAuthor.author"/>
</dataMap>
