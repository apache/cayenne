<!-- Reverse engineering settings with every setting, pattern and nested tag -->
<dataMap xmlns="http://cayenne.apache.org/schema/15/dataMap"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://cayenne.apache.org/schema/15/dataMap http://cayenne.apache.org/schema/15/dataMap.xsd"
	defaultPackage="org.example">
	<dbEntity name="ARTIST">
		<dbAttribute name="ARTIST_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="ARTIST_NAME" type="VARCHAR" length="254"/>
	</dbEntity>
	<objEntity name="Artist" className="org.example.Artist" dbEntityName="ARTIST">
		<objAttribute name="artistName" type="java.lang.String" dbAttributePath="ARTIST_NAME"/>
	</objEntity>
	<objectQuery name="objectQuery">
		<ql><![CDATA[from Artist]]></ql>
	</objectQuery>
	<dbImport>
		<includeTable>
			<name>ARTIST</name>
			<includeColumn>ARTIST_ID</includeColumn>
			<excludeColumn>ARTIST_TMP</excludeColumn>
		</includeTable>
		<excludeTable>OLD_(?&lt;name&gt;.*) &amp; more</excludeTable>
		<includeColumn>.*_ID</includeColumn>
		<excludeColumn>SECRET</excludeColumn>
		<includeProcedure>PROC_.*</includeProcedure>
		<excludeProcedure>PROC_OLD</excludeProcedure>
		<catalog>
			<excludeTable>CATALOG_TMP</excludeTable>
			<name>CATALOG_01</name>
			<schema>
				<includeTable>
					<name>PAINTING</name>
				</includeTable>
				<name>SCHEMA_01</name>
			</schema>
		</catalog>
		<schema>
			<excludeProcedure>SCHEMA_PROC</excludeProcedure>
			<name>SCHEMA_02</name>
		</schema>
		<tableTypes>
			<tableType>TABLE</tableType>
			<tableType>VIEW</tableType>
		</tableTypes>
		<defaultPackage>org.example.imported</defaultPackage>
		<forceDataMapCatalog>true</forceDataMapCatalog>
		<forceDataMapSchema>true</forceDataMapSchema>
		<meaningfulPkTables>ARTIST</meaningfulPkTables>
		<namingStrategy>org.example.NameGenerator</namingStrategy>
		<skipPrimaryKeyLoading>true</skipPrimaryKeyLoading>
		<skipRelationshipsLoading>true</skipRelationshipsLoading>
		<stripFromTableNames>^T_</stripFromTableNames>
		<useJava7Types>true</useJava7Types>
	</dbImport>
</dataMap>
