<!-- Version 10, with queries that have cache groups and comments of the "info" extension, under two prefixes -->
<data-map xmlns="http://cayenne.apache.org/schema/10/modelMap"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:i="http://cayenne.apache.org/schema/10/info"
	xsi:schemaLocation="http://cayenne.apache.org/schema/10/modelMap http://cayenne.apache.org/schema/10/modelMap.xsd"
	project-version="10">
	<property name="defaultPackage" value="org.example"/>
	<db-entity name="ARTIST">
		<db-attribute name="ARTIST_ID" type="INTEGER" isPrimaryKey="true" isMandatory="true"/>
		<db-attribute name="ARTIST_NAME" type="VARCHAR" length="254"/>
	</db-entity>
	<obj-entity name="Artist" className="org.example.Artist" dbEntityName="ARTIST">
		<obj-attribute name="artistName" type="java.lang.String" db-attribute-path="ARTIST_NAME"/>
	</obj-entity>
	<query name="ArtistQuery" type="SelectQuery" root="obj-entity" root-name="Artist">
		<property name="cayenne.GenericSelectQuery.fetchLimit" value="5"/>
		<property name="cayenne.GenericSelectQuery.pageSize" value="10"/>
		<property name="cayenne.GenericSelectQuery.cacheGroups" value="g1"/>
		<qualifier><![CDATA[artistName = "a"]]></qualifier>
		<info:property xmlns:info="http://cayenne.apache.org/schema/10/info" name="comment" value="select query"/>
	</query>
	<query name="ArtistQueryOtherPrefix" type="SelectQuery" root="obj-entity" root-name="Artist">
		<i:property name="comment" value="select query, other prefix"/>
	</query>
	<query name="ArtistSql" type="SQLTemplate" root="obj-entity" root-name="Artist">
		<property name="cayenne.GenericSelectQuery.cacheGroups" value="g2"/>
		<info:property xmlns:info="http://cayenne.apache.org/schema/10/info" name="comment" value="SQL query"/>
		<sql><![CDATA[select * from ARTIST]]></sql>
		<prefetch type="joint"><![CDATA[paintings]]></prefetch>
	</query>
</data-map>
