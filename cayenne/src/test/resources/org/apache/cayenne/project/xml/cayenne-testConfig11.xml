<!-- Validation settings, with an inspection name padded with whitespace, a blank name and an unknown name -->
<project xmlns="http://cayenne.apache.org/schema/15/project" validateOnCommit="false">
	<map name="testConfigMap2"/>
	<validation>
		<exclude>SQL_TEMPLATE_NO_ROOT</exclude>
		<exclude>
			PROJECT_NO_NAME
		</exclude>
		<exclude> </exclude>
		<exclude>NO_SUCH_INSPECTION</exclude>
		<exclude>DB_ENTITY_NO_PK</exclude>
	</validation>
</project>
