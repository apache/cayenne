<!-- Version 14, with the comments of the "info" extension and a relationship whose reverse is created on upgrade -->
<dataMap xmlns="http://cayenne.apache.org/schema/14/dataMap"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://cayenne.apache.org/schema/14/dataMap https://cayenne.apache.org/schema/14/dataMap.xsd"
	defaultPackage="org.example">
	<info:property xmlns:info="http://cayenne.apache.org/schema/14/info" name="comment" value="dataMap"/>
	<dbEntity name="ARTIST">
		<dbAttribute name="ARTIST_ID" type="INTEGER" primaryKey="true" mandatory="true">
			<info:property xmlns:info="http://cayenne.apache.org/schema/14/info" name="comment" value="dbAttribute"/>
		</dbAttribute>
		<dbAttribute name="ARTIST_NAME" type="VARCHAR" length="254"/>
		<info:property xmlns:info="http://cayenne.apache.org/schema/14/info" name="comment" value="dbEntity"/>
	</dbEntity>
	<dbEntity name="ARTIST_INFO">
		<dbAttribute name="ARTIST_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
	</dbEntity>
	<objEntity name="Artist" className="org.example.Artist" dbEntityName="ARTIST">
		<objAttribute name="artistName" type="java.lang.String" dbAttributePath="ARTIST_NAME">
			<info:property xmlns:info="http://cayenne.apache.org/schema/14/info" name="comment" value="objAttribute"/>
		</objAttribute>
		<info:property xmlns:info="http://cayenne.apache.org/schema/14/info" name="comment" value="objEntity"/>
	</objEntity>
	<dbRelationship name="toInfo" source="ARTIST" target="ARTIST_INFO" toDependentPK="true">
		<dbAttributePair source="ARTIST_ID" target="ARTIST_ID"/>
		<info:property xmlns:info="http://cayenne.apache.org/schema/14/info" name="comment" value="dbRelationship"/>
	</dbRelationship>
</dataMap>
