<!-- Version 10, with the reverse engineering settings in the legacy "config" root tag of the "dbimport" extension -->
<data-map xmlns="http://cayenne.apache.org/schema/10/modelMap"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://cayenne.apache.org/schema/10/modelMap http://cayenne.apache.org/schema/10/modelMap.xsd"
	project-version="10">
	<property name="defaultPackage" value="org.example"/>
	<db-entity name="ARTIST">
		<db-attribute name="ARTIST_ID" type="INTEGER" isPrimaryKey="true" isMandatory="true"/>
	</db-entity>
	<config xmlns="http://cayenne.apache.org/schema/10/dbimport">
		<schema>
			<name>SCHEMA_01</name>
			<excludeTable>TMP_.*</excludeTable>
		</schema>
		<defaultPackage>org.example.imported</defaultPackage>
		<usePrimitives>true</usePrimitives>
	</config>
</data-map>
