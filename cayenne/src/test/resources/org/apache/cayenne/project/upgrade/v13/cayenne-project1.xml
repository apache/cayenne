<?xml version="1.0" encoding="utf-8"?>
<domain xmlns="http://cayenne.apache.org/schema/12/domain"
	 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="http://cayenne.apache.org/schema/12/domain https://cayenne.apache.org/schema/12/domain.xsd"
	 project-version="12">
	<map name="map1"/>
	<node name="node1"
		 adapter="org.example.test.Adapter"
		 factory="org.apache.cayenne.configuration.runtime.XMLPoolingDataSourceFactory">
		<map-ref name="map1"/>
		<data-source>
			<driver value="org.hsqldb.jdbcDriver"/>
			<url value="jdbc:hsqldb:mem:testdb"/>
			<connectionPool min="1" max="1"/>
			<login userName="sa"/>
		</data-source>
	</node>
	<node name="node2"
		 factory="org.apache.cayenne.configuration.runtime.JNDIDataSourceFactory"
		 parameters="jdbc/testdb"/>
	<validation xmlns="http://cayenne.apache.org/schema/12/validation">
		<exclude>DATA_CHANNEL_NO_NAME</exclude>
		<exclude>DATA_NODE_NO_NAME</exclude>
		<exclude>DATA_NODE_NAME_DUPLICATE</exclude>
		<exclude>DATA_NODE_CONNECTION_PARAMS</exclude>
		<exclude>DATA_MAP_NODE_LINKAGE</exclude>
	</validation>
</domain>
