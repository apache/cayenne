<!-- Version 14, with the class generation settings of the "cgen" extension -->
<dataMap xmlns="http://cayenne.apache.org/schema/14/dataMap"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://cayenne.apache.org/schema/14/dataMap https://cayenne.apache.org/schema/14/dataMap.xsd"
	defaultPackage="org.example">
	<dbEntity name="ARTIST">
		<dbAttribute name="ARTIST_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
	</dbEntity>
	<objEntity name="Artist" className="org.example.Artist" dbEntityName="ARTIST"/>
	<cgen xmlns="http://cayenne.apache.org/schema/14/cgen">
		<name>Default</name>
		<excludeEntities>Artist</excludeEntities>
		<destDir>../java</destDir>
		<mode>entity</mode>
		<template>templates/v4_1/subclass.vm</template>
		<superTemplate><![CDATA[custom superclass]]></superTemplate>
		<outputPattern>*.java</outputPattern>
		<makePairs>true</makePairs>
		<usePkgPath>true</usePkgPath>
		<overwrite>false</overwrite>
		<createPropertyNames>false</createPropertyNames>
		<createPKProperties>true</createPKProperties>
	</cgen>
</dataMap>
