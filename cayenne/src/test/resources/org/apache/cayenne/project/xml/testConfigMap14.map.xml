<!-- A comment on every kind of element that can have one -->
<dataMap xmlns="http://cayenne.apache.org/schema/15/dataMap"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://cayenne.apache.org/schema/15/dataMap http://cayenne.apache.org/schema/15/dataMap.xsd"
	defaultPackage="org.example">
	<comment>dataMap &amp; &lt;escaped&gt;</comment>
	<embeddable className="org.example.Address">
		<comment>embeddable</comment>
		<embeddableAttribute name="city" type="java.lang.String" dbAttributeName="CITY">
			<comment>embeddableAttribute</comment>
		</embeddableAttribute>
		<embeddableAttribute name="street" type="java.lang.String" dbAttributeName="STREET"/>
	</embeddable>
	<procedure name="proc">
		<comment>procedure</comment>
		<procedureParameter name="in_param" type="INTEGER" direction="in">
			<comment>procedureParameter</comment>
		</procedureParameter>
		<procedureParameter name="out_param" type="INTEGER" direction="out"/>
	</procedure>
	<dbEntity name="ARTIST">
		<comment>dbEntity</comment>
		<dbAttribute name="ARTIST_ID" type="INTEGER" primaryKey="true" mandatory="true">
			<comment>dbAttribute</comment>
		</dbAttribute>
		<dbAttribute name="ARTIST_NAME" type="VARCHAR" length="254"/>
		<dbAttribute name="CITY" type="VARCHAR" length="100">
			<comment>
				multi-line
				dbAttribute
			</comment>
		</dbAttribute>
		<dbAttribute name="STREET" type="VARCHAR" length="100">
			<comment>  </comment>
		</dbAttribute>
	</dbEntity>
	<dbEntity name="PAINTING">
		<dbAttribute name="ARTIST_ID" type="INTEGER"/>
		<dbAttribute name="PAINTING_ID" type="INTEGER" primaryKey="true" mandatory="true"/>
	</dbEntity>
	<objEntity name="Artist" className="org.example.Artist" dbEntityName="ARTIST">
		<comment>objEntity</comment>
		<embeddedAttribute name="address" type="org.example.Address">
			<comment>embeddedAttribute</comment>
			<embeddableAttributeOverride name="city" dbAttributePath="CITY"/>
		</embeddedAttribute>
		<objAttribute name="artistName" type="java.lang.String" dbAttributePath="ARTIST_NAME">
			<comment>objAttribute</comment>
		</objAttribute>
	</objEntity>
	<objEntity name="Painting" className="org.example.Painting" dbEntityName="PAINTING"/>
	<dbRelationship name="paintings" source="ARTIST" target="PAINTING" toMany="true">
		<comment>dbRelationship</comment>
		<dbAttributePair source="ARTIST_ID" target="ARTIST_ID"/>
	</dbRelationship>
	<dbRelationship name="artist" source="PAINTING" target="ARTIST" foreignKey="true">
		<dbAttributePair source="ARTIST_ID" target="ARTIST_ID"/>
	</dbRelationship>
	<objRelationship name="paintings" source="Artist" target="Painting" dbRelationshipPath="paintings">
		<comment>objRelationship</comment>
	</objRelationship>
	<objRelationship name="artist" source="Painting" target="Artist" dbRelationshipPath="artist"/>
	<objectQuery name="objectQuery">
		<comment>objectQuery</comment>
		<ql><![CDATA[from Artist]]></ql>
	</objectQuery>
	<procedureQuery name="procedureQuery" root="procedure" rootName="proc">
		<comment>procedureQuery</comment>
	</procedureQuery>
	<sqlQuery name="sqlQuery" root="dataMap">
		<comment>sqlQuery</comment>
		<sql><![CDATA[SELECT * FROM ARTIST]]></sql>
	</sqlQuery>
</dataMap>
