<?xml version="1.0" encoding="utf-8"?>
<dataMap xmlns="http://cayenne.apache.org/schema/14/dataMap"
	 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="http://cayenne.apache.org/schema/14/dataMap https://cayenne.apache.org/schema/14/dataMap.xsd">
	<property name="defaultPackage" value="org.apache.cayenne.testdo.db2"/>
	<dbEntity name="CROSSDB_M2E1">
		<dbAttribute name="ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="NAME" type="VARCHAR" length="100"/>
	</dbEntity>
	<dbEntity name="CROSSDB_M2E2">
		<dbAttribute name="ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="M1E1_ID" type="INTEGER"/>
		<dbAttribute name="M2E1_ID" type="INTEGER"/>
		<dbAttribute name="NAME" type="VARCHAR" length="200"/>
	</dbEntity>
	<objEntity name="CrossdbM2E1" className="org.apache.cayenne.testdo.db2.CrossdbM2E1" dbEntityName="CROSSDB_M2E1">
		<objAttribute name="name" type="java.lang.String" dbAttributePath="NAME"/>
	</objEntity>
	<objEntity name="CrossdbM2E2" className="org.apache.cayenne.testdo.db2.CrossdbM2E2" dbEntityName="CROSSDB_M2E2">
		<objAttribute name="name" type="java.lang.String" dbAttributePath="NAME"/>
	</objEntity>
	<dbRelationship name="listOfM2E2" source="CROSSDB_M2E1" target="CROSSDB_M2E2" toMany="true">
		<dbAttributePair source="ID" target="M2E1_ID"/>
	</dbRelationship>
	<dbRelationship name="toM1E1" source="CROSSDB_M2E2" target="CROSSDB_M1E1">
		<dbAttributePair source="M1E1_ID" target="ID"/>
	</dbRelationship>
	<dbRelationship name="toM2E1" source="CROSSDB_M2E2" target="CROSSDB_M2E1">
		<dbAttributePair source="M2E1_ID" target="ID"/>
	</dbRelationship>
	<objRelationship name="listOfM2E2" source="CrossdbM2E1" target="CrossdbM2E2" dbRelationshipPath="listOfM2E2"/>
	<objRelationship name="toM1E1" source="CrossdbM2E2" target="CrossdbM1E1" dbRelationshipPath="toM1E1"/>
	<objRelationship name="toM2E1" source="CrossdbM2E2" target="CrossdbM2E1" dbRelationshipPath="toM2E1"/>
</dataMap>
