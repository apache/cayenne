<?xml version="1.0" encoding="utf-8"?>
<dataMap xmlns="http://cayenne.apache.org/schema/15/dataMap"
	 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="http://cayenne.apache.org/schema/15/dataMap https://cayenne.apache.org/schema/15/dataMap.xsd"
	 defaultPackage="org.apache.cayenne.testdo.reflexive">
	<dbEntity name="OTHER">
		<dbAttribute name="ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="NAME" type="VARCHAR" mandatory="true" length="200"/>
	</dbEntity>
	<dbEntity name="REFLEXIVE">
		<dbAttribute name="ID" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="NAME" type="VARCHAR" mandatory="true" length="200"/>
		<dbAttribute name="OTHER_ID" type="INTEGER"/>
		<dbAttribute name="PARENT_ID" type="INTEGER"/>
	</dbEntity>
	<objEntity name="Other" className="org.apache.cayenne.testdo.reflexive.Other" dbEntityName="OTHER">
		<objAttribute name="name" type="java.lang.String" dbAttributePath="NAME"/>
	</objEntity>
	<objEntity name="Reflexive" className="org.apache.cayenne.testdo.reflexive.Reflexive" dbEntityName="REFLEXIVE">
		<objAttribute name="name" type="java.lang.String" dbAttributePath="NAME"/>
	</objEntity>
	<dbRelationship name="reflexives" source="OTHER" target="REFLEXIVE" toMany="true">
		<dbAttributePair source="ID" target="OTHER_ID"/>
	</dbRelationship>
	<dbRelationship name="children" source="REFLEXIVE" target="REFLEXIVE" toMany="true">
		<dbAttributePair source="ID" target="PARENT_ID"/>
	</dbRelationship>
	<dbRelationship name="other" source="REFLEXIVE" target="OTHER" foreignKey="true">
		<dbAttributePair source="OTHER_ID" target="ID"/>
	</dbRelationship>
	<dbRelationship name="parent" source="REFLEXIVE" target="REFLEXIVE" foreignKey="true">
		<dbAttributePair source="PARENT_ID" target="ID"/>
	</dbRelationship>
	<objRelationship name="reflexives" source="Other" target="Reflexive" dbRelationshipPath="reflexives"/>
	<objRelationship name="children" source="Reflexive" target="Reflexive" dbRelationshipPath="children"/>
	<objRelationship name="other" source="Reflexive" target="Other" dbRelationshipPath="other"/>
	<objRelationship name="parent" source="Reflexive" target="Reflexive" dbRelationshipPath="parent"/>
</dataMap>
