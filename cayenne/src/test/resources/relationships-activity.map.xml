<?xml version="1.0" encoding="utf-8"?>
<dataMap xmlns="http://cayenne.apache.org/schema/14/dataMap"
	 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="http://cayenne.apache.org/schema/14/dataMap https://cayenne.apache.org/schema/14/dataMap.xsd"
	 defaultPackage="org.apache.cayenne.testdo.relationships_activity">
	<dbEntity name="X_ACTIVITY">
		<dbAttribute name="ACTIVITY_ID" type="VARCHAR" primaryKey="true" mandatory="true" length="50"/>
		<dbAttribute name="APPOINT_DATE" type="DATE" mandatory="true"/>
		<dbAttribute name="APPOINT_NO" type="INTEGER" mandatory="true"/>
	</dbEntity>
	<dbEntity name="X_RESULT">
		<dbAttribute name="APPOINT_DATE" type="DATE" primaryKey="true" mandatory="true"/>
		<dbAttribute name="APPOINT_NO" type="INTEGER" primaryKey="true" mandatory="true"/>
		<dbAttribute name="RESULTNAME" type="VARCHAR" primaryKey="true" mandatory="true" length="50"/>
	</dbEntity>
	<objEntity name="Activity" className="org.apache.cayenne.testdo.relationships_activity.Activity" dbEntityName="X_ACTIVITY">
		<objAttribute name="appointmentDate" type="java.sql.Date" dbAttributePath="APPOINT_DATE"/>
		<objAttribute name="appointmentNo" type="int" dbAttributePath="APPOINT_NO"/>
	</objEntity>
	<objEntity name="ActivityResult" className="org.apache.cayenne.testdo.relationships_activity.ActivityResult" dbEntityName="X_RESULT">
		<objAttribute name="appointDate" type="java.sql.Date" dbAttributePath="APPOINT_DATE"/>
		<objAttribute name="appointNo" type="int" dbAttributePath="APPOINT_NO"/>
		<objAttribute name="field" type="java.lang.String" dbAttributePath="RESULTNAME"/>
	</objEntity>
	<dbRelationship name="ActivityResultsRel" source="X_ACTIVITY" target="X_RESULT" toMany="true">
		<dbAttributePair source="APPOINT_DATE" target="APPOINT_DATE"/>
		<dbAttributePair source="APPOINT_NO" target="APPOINT_NO"/>
	</dbRelationship>
	<dbRelationship name="ActivitiesRel" source="X_RESULT" target="X_ACTIVITY" toMany="true">
		<dbAttributePair source="APPOINT_DATE" target="APPOINT_DATE"/>
		<dbAttributePair source="APPOINT_NO" target="APPOINT_NO"/>
	</dbRelationship>
	<objRelationship name="results" source="Activity" target="ActivityResult" collectionType="java.util.Map" mapKey="field" deleteRule="deny" dbRelationshipPath="ActivityResultsRel"/>
</dataMap>
