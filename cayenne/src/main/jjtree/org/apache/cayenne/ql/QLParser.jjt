package org.apache.cayenne.ql;

import java.math.BigDecimal;
import java.math.BigInteger;
import java.util.HashMap;
import java.util.Map;
import org.apache.cayenne.exp.*;
import org.apache.cayenne.query.FluentSelect;
import org.apache.cayenne.query.PrefetchTreeNode;

/**
  * Parser of Cayenne expressions and queries. Has two entry points: {@link #expression()} that parses a standalone
  * expression, and {@link #query()} that parses a full select query, whose clauses embed the same expressions.
  *
  * @since 5.0 renamed from ExpressionParser and extended to parse queries.
  */
public class QLParser {

    private Object[] parameters;
    private int parameterIndex;
    private Map<String, Object> seenParameters;

    /**
     * Sets positional parameters to bind in place of "$name" tokens as they are encountered in the parsed String.
     * A name that occurs more than once consumes a single value. If not called, named parameters are preserved
     * in the parsed expression.
     */
    public void setParameters(Object... parameters) {
        this.parameters = parameters;
    }

    /**
     * Should be called when the parsing is finished to ensure all positional parameters were consumed.
     */
    public void checkParametersBound() {
        if (parameters != null && parameterIndex < parameters.length) {
            throw new ExpressionException("Too many parameters to bind expression. Expected: " + parameterIndex
                    + ", actual: " + parameters.length);
        }
    }

    private BaseExp boundParameter(String name) {
        if (seenParameters == null) {
            seenParameters = new HashMap<String, Object>();
        }

        Object value;
        if (seenParameters.containsKey(name)) {
            value = seenParameters.get(name);
        } else {
            if (parameterIndex >= parameters.length) {
                throw new ExpressionException("Too few parameters to bind expression: " + parameters.length);
            }
            value = parameters[parameterIndex++];
            seenParameters.put(name, value);
        }

        return QLParserHelper.parameterNode(value);
    }

    // Query keywords are contextual: they are regular path tokens that are only treated as keywords
    // in the positions where a query clause is expected, so they stay valid as property names in expressions

    private boolean isKeyword(int offset, String keyword) {
        Token t = getToken(offset);
        return t.kind == PROPERTY_PATH && keyword.equals(t.image);
    }

    private boolean isKeywordWithParen(int offset, String keyword) {
        return isKeyword(offset, keyword) && "(".equals(getToken(offset + 1).image);
    }

    private boolean isSubquery(int offset) {
        return "(".equals(getToken(offset).image)
            && (isKeyword(offset + 1, "select") || isKeyword(offset + 1, "from"));
    }

    private ParseException unexpectedToken(Token t, String expected) {
        return new ParseException("Encountered \"" + t.image + "\" at line " + t.beginLine + ", column "
            + t.beginColumn + ". Was expecting: " + expected);
    }

    /**
     * Creates an empty node for each node id declared in this grammar. JJTree calls this instead of the node
     * constructors (see the NODE_FACTORY option), so a new "#SomethingExp" declaration below needs a case here.
     */
    private static BaseExp jjtCreate(int id) {
        // a switch statement, not a switch expression: JJTree can't parse the latter
        switch (id) {
            case JJTALLEXP: return new AllExp();
            case JJTANYEXP: return new AnyExp();
            case JJTOREXP: return new OrExp();
            case JJTANDEXP: return new AndExp();
            case JJTNOTEXISTSEXP: return new NotExistsExp();
            case JJTEXISTSEXP: return new ExistsExp();
            case JJTNOTEXP: return new NotExp();
            case JJTTRUEEXP: return new TrueExp();
            case JJTFALSEEXP: return new FalseExp();
            case JJTEQUALEXP: return new EqualExp();
            case JJTNOTEQUALEXP: return new NotEqualExp();
            case JJTLESSOREQUALEXP: return new LessOrEqualExp();
            case JJTLESSEXP: return new LessExp();
            case JJTGREATEREXP: return new GreaterExp();
            case JJTGREATEROREQUALEXP: return new GreaterOrEqualExp();
            case JJTLIKEEXP: return new LikeExp();
            case JJTLIKEIGNORECASEEXP: return new LikeIgnoreCaseExp();
            case JJTINEXP: return new InExp();
            case JJTBETWEENEXP: return new BetweenExp();
            case JJTNOTLIKEEXP: return new NotLikeExp();
            case JJTNOTLIKEIGNORECASEEXP: return new NotLikeIgnoreCaseExp();
            case JJTNOTINEXP: return new NotInExp();
            case JJTNOTBETWEENEXP: return new NotBetweenExp();
            case JJTLISTEXP: return new ListExp();
            case JJTSCALAREXP: return new ScalarExp();
            case JJTBITWISEOREXP: return new BitwiseOrExp();
            case JJTBITWISEXOREXP: return new BitwiseXorExp();
            case JJTBITWISEANDEXP: return new BitwiseAndExp();
            case JJTBITWISELEFTSHIFTEXP: return new BitwiseLeftShiftExp();
            case JJTBITWISERIGHTSHIFTEXP: return new BitwiseRightShiftExp();
            case JJTADDEXP: return new AddExp();
            case JJTSUBTRACTEXP: return new SubtractExp();
            case JJTMULTIPLYEXP: return new MultiplyExp();
            case JJTDIVIDEEXP: return new DivideExp();
            case JJTBITWISENOTEXP: return new BitwiseNotExp();
            case JJTNEGATEEXP: return new NegateExp();
            case JJTFULLOBJECTEXP: return new FullObjectExp();
            case JJTENCLOSINGOBJECTEXP: return new EnclosingObjectExp();
            case JJTCUSTOMFUNCTIONEXP: return new CustomFunctionExp();
            case JJTCUSTOMOPERATOREXP: return new CustomOperatorExp();
            case JJTCUSTOMAGGREGATEEXP: return new CustomAggregateExp();
            case JJTCONCATEXP: return new ConcatExp();
            case JJTSUBSTRINGEXP: return new SubstringExp();
            case JJTTRIMEXP: return new TrimExp();
            case JJTLOWEREXP: return new LowerExp();
            case JJTUPPEREXP: return new UpperExp();
            case JJTLENGTHEXP: return new LengthExp();
            case JJTLOCATEEXP: return new LocateExp();
            case JJTABSEXP: return new AbsExp();
            case JJTSQRTEXP: return new SqrtExp();
            case JJTMODEXP: return new ModExp();
            case JJTASTERISKEXP: return new AsteriskExp();
            case JJTCOUNTEXP: return new CountExp();
            case JJTAVGEXP: return new AvgExp();
            case JJTMAXEXP: return new MaxExp();
            case JJTMINEXP: return new MinExp();
            case JJTSUMEXP: return new SumExp();
            case JJTCURRENTDATEEXP: return new CurrentDateExp();
            case JJTCURRENTTIMEEXP: return new CurrentTimeExp();
            case JJTCURRENTTIMESTAMPEXP: return new CurrentTimestampExp();
            case JJTEXTRACTEXP: return new ExtractExp();
            case JJTDISTINCTEXP: return new DistinctExp();
            case JJTNAMEDPARAMETEREXP: return new NamedParameterExp();
            case JJTOBJPATHEXP: return new ObjPathExp();
            case JJTDBPATHEXP: return new DbPathExp();
            case JJTENUMEXP: return new EnumExp();
            case JJTDBIDPATHEXP: return new DbIdPathExp();
            default: throw new ExpressionException("Unknown node id: " + id);
        }
    }

    private Expression popExpression() {
        return (Expression) jjtree.popNode();
    }
}

PARSER_END(QLParser)


Expression expression() : {}
{
	orCondition() <EOF>
    {
        return (Expression) jjtree.rootNode();
    }
}

FluentSelect<?, ?> query() : {
    FluentSelect<?, ?> query;
}
{
    query = select(true) <EOF>
    {
        return query;
    }
}

FluentSelect<?, ?> select(boolean root) : {
    QLSelectBuilder builder = new QLSelectBuilder();
}
{
    [ LOOKAHEAD({ isKeyword(1, "select") }) selectClause(builder) ]
    fromClause(builder)
    [ LOOKAHEAD({ isKeyword(1, "where") }) keyword("where") orCondition() { builder.where(popExpression()); } ]
    [ LOOKAHEAD({ isKeyword(1, "having") }) keyword("having") orCondition() { builder.having(popExpression()); } ]
    [ LOOKAHEAD({ isKeyword(1, "order") }) orderClause(builder) ]
    [ LOOKAHEAD({ isKeyword(1, "limit") }) limitClause(builder) ]
    [ LOOKAHEAD({ isKeyword(1, "offset") }) offsetClause(builder) ]
    [ LOOKAHEAD({ root && isKeyword(1, "prefetch") }) prefetchClause(builder) ]
    {
        return builder.build();
    }
}

void keyword(String keyword) : {
    Token t;
}
{
    t = <PROPERTY_PATH>
    {
        if (!keyword.equals(t.image)) {
            throw unexpectedToken(t, "\"" + keyword + "\"");
        }
    }
}

// a simple name with no path separators, join or alias markers
String name() : {
    Token t;
}
{
    t = pathToken()
    {
        if (t.image.indexOf('.') >= 0 || t.image.indexOf('+') >= 0 || t.image.indexOf('#') >= 0) {
            throw unexpectedToken(t, "a simple name");
        }
        return t.image;
    }
}

void selectClause(QLSelectBuilder builder) : {}
{
    keyword("select") [ <DISTINCT> { builder.distinct(); } ] column(builder) ( "," column(builder) )*
}

void column(QLSelectBuilder builder) : {
    String alias = null;
}
{
    orCondition() [ LOOKAHEAD({ isKeyword(1, "as") }) keyword("as") alias = name() ]
    {
        builder.column(popExpression(), alias);
    }
}

void fromClause(QLSelectBuilder builder) : {
    String name;
}
{
    keyword("from")
    (
        "db:" name = name() { builder.fromDbEntity(name); }
    |
        name = name() { builder.fromObjEntity(name); }
    )
}

void orderClause(QLSelectBuilder builder) : {}
{
    keyword("order") keyword("by") ordering(builder) ( "," ordering(builder) )*
}

void ordering(QLSelectBuilder builder) : {
    boolean ascending = true;
    boolean insensitive = false;
}
{
    orCondition()
    [
        LOOKAHEAD({ isKeyword(1, "asc") }) keyword("asc")
    |
        LOOKAHEAD({ isKeyword(1, "desc") }) keyword("desc") { ascending = false; }
    ]
    [ LOOKAHEAD({ isKeyword(1, "insensitive") }) keyword("insensitive") { insensitive = true; } ]
    {
        builder.ordering(popExpression(), ascending, insensitive);
    }
}

void limitClause(QLSelectBuilder builder) : {}
{
    keyword("limit") <INT_LITERAL> { builder.limit(((Number) token_source.literalValue).intValue()); }
}

void offsetClause(QLSelectBuilder builder) : {}
{
    keyword("offset") <INT_LITERAL> { builder.offset(((Number) token_source.literalValue).intValue()); }
}

void prefetchClause(QLSelectBuilder builder) : {}
{
    keyword("prefetch") prefetch(builder) ( "," prefetch(builder) )*
}

void prefetch(QLSelectBuilder builder) : {
    Token path;
    Token t;
    int semantics = PrefetchTreeNode.UNDEFINED_SEMANTICS;
}
{
    path = <PROPERTY_PATH>
    [
        t = <PROPERTY_PATH>
        {
            switch (t.image) {
                case "joint":
                    semantics = PrefetchTreeNode.JOINT_PREFETCH_SEMANTICS;
                    break;
                case "disjoint":
                    semantics = PrefetchTreeNode.DISJOINT_PREFETCH_SEMANTICS;
                    break;
                case "disjointById":
                    semantics = PrefetchTreeNode.DISJOINT_BY_ID_PREFETCH_SEMANTICS;
                    break;
                default:
                    throw unexpectedToken(t, "\"joint\", \"disjoint\" or \"disjointById\"");
            }
        }
    ]
    {
        builder.prefetch(path.image, semantics);
    }
}

// a nested select in parentheses; pushes a single subquery node on the stack
void subquery() : {
    FluentSelect<?, ?> query;
}
{
    "(" query = select(false) ")"
    {
        jjtree.pushNode(new SubqueryExp(query));
    }
}

void allSubquery() #AllExp(1) : {}
{
    keyword("all") subquery()
}

void anySubquery() #AnyExp(1) : {}
{
    keyword("any") subquery()
}

// right-hand side of a comparison: a scalar, or a quantified subquery
void comparisonOperand() : {}
{
        LOOKAHEAD({ isKeywordWithParen(1, "all") }) allSubquery()
    |
        LOOKAHEAD({ isKeywordWithParen(1, "any") }) anySubquery()
    |
        scalarExpression()
}

// right-hand side of "in": a parameter, a subquery or a list of constants
void inOperand() : {}
{
        namedParameter()
    |
        LOOKAHEAD({ isSubquery(1) }) subquery()
    |
        "(" scalarCommaList() ")"
}

void orCondition() : {}
{
	andCondition() ( "or" andCondition() #OrExp(2) )*
}

void andCondition() : {}
{
	notCondition() ( "and" notCondition() #AndExp(2) )*
}

void notCondition() : {}
{
    // note: `not exists` rule must be before `not` to avoid lookahead
    // subquery forms must be before the path forms, they are distinguished by "(select" or "(from" that follows
        LOOKAHEAD({ getToken(1).kind == NOT_EXISTS && isSubquery(2) }) <NOT_EXISTS> subquery() #NotExistsExp(1)
    |
        <NOT_EXISTS> simpleCondition() #NotExistsExp(1)
    |
        LOOKAHEAD({ getToken(1).kind == EXISTS && isSubquery(2) }) <EXISTS> subquery() #ExistsExp(1)
    |
	    <EXISTS> simpleCondition() #ExistsExp(1)
    |
		( "not" | "!" ) simpleCondition() #NotExp(1)
	|
		simpleCondition()
}

void simpleCondition() : {} 
{
	  <TRUE> #TrueExp
	|
	  <FALSE> #FalseExp
	|
	  conditionExpression()
	(
          ("="  | "==") comparisonOperand() #EqualExp(2)
        |
          ("!=" | "<>")  comparisonOperand() #NotEqualExp(2)
        |
          "<=" comparisonOperand() #LessOrEqualExp(2)
        |
          "<" comparisonOperand() #LessExp(2)
        |
          ">"  comparisonOperand() #GreaterExp(2)
        |
          ">=" comparisonOperand() #GreaterOrEqualExp(2)
        |
          "like" scalarExpression() #LikeExp(2)
        |
          "likeIgnoreCase"  scalarExpression() #LikeIgnoreCaseExp(2)
        |
          "in" inOperand() #InExp(2)
        |
          "between"  scalarExpression() "and" scalarExpression() #BetweenExp(3)
        |
          simpleNotCondition()
	)?
}

void simpleNotCondition() : {} 
{
	("not" | "!" )
	(
		"like" scalarExpression() #NotLikeExp(2)
	|
	    "likeIgnoreCase"  scalarExpression() #NotLikeIgnoreCaseExp(2)
	|
		"in" inOperand() #NotInExp(2)
	|
		"between"  scalarExpression() "and" scalarExpression() #NotBetweenExp(3)
	)
}

void scalarCommaList() : {}
{
	( scalarConstExpression() ( ","  scalarConstExpression() )* ) #ListExp
}

void conditionExpression() : {}
{
   // TODO: once we switch expression package to use AST* from parser package,
   // we might need implement special subclasses for numeric and character constant
   // nodes for the purpose of expression evaluation, instead . For now keep them as 
   // generic ScalarExp and purge from the parent node to keep compatible with QualifierTranslator.

        // Path without any operator will go to numeric expression.
        // This done intentionally to remove lookahead that leads
        // to dramatically perfomance degradation (parser can become 3 times slower)
		numericExpression()
    |
        stringExpression()
	|
		<NULL> #ScalarExp(0)
	|
    	aggregateExpression()
    |
        dateTimeFunction()
}

void stringParameter() : {}
{
        pathExpression()
    |
        stringExpression()
    |
        customFunction()
    |
        customOperator()
    |
        customAggregate()
}

void stringLiteral() :  {}
{
    <SINGLE_QUOTED_STRING> { jjtThis.setValue(token_source.literalValue); } #ScalarExp(0)
    |
    <DOUBLE_QUOTED_STRING> { jjtThis.setValue(token_source.literalValue); } #ScalarExp(0)
}

void stringExpression() : {}
{
    stringLiteral()
    |
    functionsReturningStrings()
}

void scalarExpression() : {} 
{
  	   conditionExpression()
	|
	  <TRUE> { jjtThis.setValue(true); }  #ScalarExp(0)
	| 
	  <FALSE> { jjtThis.setValue(false); }  #ScalarExp(0)
}

void scalarConstExpression() : {}
{
	  <SINGLE_QUOTED_STRING> { jjtThis.setValue(token_source.literalValue); } #ScalarExp(0)
	|
	  <DOUBLE_QUOTED_STRING> { jjtThis.setValue(token_source.literalValue); } #ScalarExp(0)
	| 
	  namedParameter()
	| 
	  <INT_LITERAL>   { jjtThis.setValue(token_source.literalValue); } #ScalarExp(0)
	| 
	  <FLOAT_LITERAL> { jjtThis.setValue(token_source.literalValue); } #ScalarExp(0)
	|
	  <TRUE>  { jjtThis.setValue(true);  } #ScalarExp(0)
	| 
	  <FALSE> { jjtThis.setValue(false); } #ScalarExp(0)
}

void numericExpression() : {}
{
    bitwiseOr()
}

void bitwiseOr() : {}
{
    bitwiseXor()
    (
        "|" bitwiseXor() #BitwiseOrExp(2)
    )*
}

void bitwiseXor() : {}
{
    bitwiseAnd()
    (
        "^" bitwiseAnd() #BitwiseXorExp(2)
    )*
}

void bitwiseAnd() : {}
{
    bitwiseShift()
    (
        "&" bitwiseShift() #BitwiseAndExp(2)
    )*
}

void bitwiseShift(): {}
{
    arithmeticExp()
    (
        "<<" arithmeticExp() #BitwiseLeftShiftExp(2)
      | 
        ">>" arithmeticExp() #BitwiseRightShiftExp(2)
    )*
}


void arithmeticExp() : {}
{
    multiplySubtractExp() 
    ( 
        "+" multiplySubtractExp() #AddExp(2)
    |
        "-" multiplySubtractExp() #SubtractExp(2)
    )*
}

void multiplySubtractExp() : {} 
{
    numericTermExt() 
    ( 
        <ASTERISK> numericTermExt() #MultiplyExp(2)
    |
        "/" numericTermExt() #DivideExp(2)
    )*
}

void numericTermExt() : {}
{
        numericTerm()
    |
        "~" numericTerm()  #BitwiseNotExp(1)
}

  
void numericTerm() : {} 
{
        ( "+" )?  numericPrimary ()
    | 
        "-"  numericTerm() #NegateExp(1)
}


void numericPrimary() : {} 
{
		// technically we shouldn't make a condition a child of scalar expression
		// but this will be handled in the code to avoid long lookaheads
		
		"(" orCondition() ")"
	|
	    <SELF> #FullObjectExp(0)
	|
	    LOOKAHEAD({ isKeywordWithParen(1, "enclosing") }) enclosing()
	|
	   <INT_LITERAL> { jjtThis.setValue(token_source.literalValue); } #ScalarExp(0)
	| 
	   <FLOAT_LITERAL>{ jjtThis.setValue(token_source.literalValue); }  #ScalarExp(0)
	|
        namedParameter()
    |
        functionsReturningNumerics()
	|
        pathExpression()
    |
        customFunction()
    |
        customOperator()
    |
        customAggregate()
}

void enclosing() #EnclosingObjectExp(1) : {}
{
    keyword("enclosing") "(" orCondition() ")"
}

void functionsReturningStrings() : { }
{
	concat() | substring() | trim() | lower() | upper()
}

void customFunction() #CustomFunctionExp : { }
{
    // the quoted name is an attribute of the node, not an operand: read it off the token instead of parsing a literal
    <FUNCTION> "(" ( <SINGLE_QUOTED_STRING> | <DOUBLE_QUOTED_STRING> ) { jjtThis.setFunctionName((String) token_source.literalValue); }
        ( "," ( stringExpression() | numericExpression() ) )* ")"
}

void customOperator() #CustomOperatorExp : { }
{
    // the quoted name is an attribute of the node, not an operand: read it off the token instead of parsing a literal
    <OPERATOR> "(" ( <SINGLE_QUOTED_STRING> | <DOUBLE_QUOTED_STRING> ) { jjtThis.setOperator((String) token_source.literalValue); }
        ( "," ( stringExpression() | numericExpression() ) )* ")"
}

void customAggregate() #CustomAggregateExp : { }
{
    // the quoted name is an attribute of the node, not an operand: read it off the token instead of parsing a literal
    <AGGREGATE> "(" ( <SINGLE_QUOTED_STRING> | <DOUBLE_QUOTED_STRING> ) { jjtThis.setFunctionName((String) token_source.literalValue); }
        ( "," ( stringExpression() | numericExpression() ) )* ")"
}

void concat() #ConcatExp : { }
{
	<CONCAT> "(" stringParameter() ( "," stringParameter() )* ")"
}

void substring() #SubstringExp : { }
{
	<SUBSTRING> "(" stringParameter() "," numericExpression() ["," numericExpression()] ")"
}

void trim() #TrimExp : { }
{
	<TRIM> "(" stringParameter() ")"
}

void lower() #LowerExp : { }
{
	<LOWER> "(" stringParameter() ")"
}

void upper() #UpperExp : { }
{
	<UPPER> "(" stringParameter() ")"
}

void functionsReturningNumerics() : { }
{
	length() | locate() | abs() | sqrt() | mod() | dateTimeExtractingFunction()
}

void length() #LengthExp : { }
{
	<LENGTH> "(" stringParameter() ")"
}

void locate() #LocateExp : { }
{
	<LOCATE> "(" stringParameter() "," stringParameter() ["," numericExpression()] ")"
}

void abs() #AbsExp : { }
{
	<ABS> "(" numericExpression() ")"
}

void sqrt() #SqrtExp : { }
{
	<SQRT> "(" numericExpression() ")"
}

void mod() #ModExp : { }
{
	<MOD> "(" numericExpression() "," numericExpression() ")"
}

void aggregateExpression() : { }
{
	avg() | max() | min() | sum() | count()
}

void asterisk() #AsteriskExp : {}
{
    <ASTERISK>
}

void count() #CountExp : { }
{
	<COUNT> "(" ( asterisk() | pathExpression() | distinct() ) ")"
}

void avg() #AvgExp : { }
{
	<AVG> "(" numericExpression() ")"
}

void max() #MaxExp : { }
{
	<MAX> "(" numericExpression() ")"
}

void min() #MinExp : { }
{
	<MIN> "(" numericExpression() ")"
}

void sum() #SumExp : { }
{
	<SUM> "(" numericExpression() ")"
}

void dateTimeFunction() : { }
{
    currentDate() | currentTime() | currentTimestamp()
}

void currentDate() #CurrentDateExp : {}
{
    <CURRENT_DATE> "(" ")"
}

void currentTime() #CurrentTimeExp : {}
{
    <CURRENT_TIME> "(" ")"
}

void currentTimestamp() #CurrentTimestampExp : {}
{
    <CURRENT_TIMESTAMP> "(" ")"
}

/* Date/time parts extracting function */
void dateTimeExtractingFunction() #ExtractExp(1) : {
    Token t;
}
{
    (
        t = <YEAR>
        | t = <MONTH>
        | t = <WEEK>
        | t = <DAY_OF_YEAR>
        | t = <DAY>
        | t = <DAY_OF_MONTH>
        | t = <DAY_OF_WEEK>
        | t = <HOUR>
        | t = <MINUTE>
        | t = <SECOND>
    ) {
        jjtThis.setPartToken(t.image);
    }
    "(" pathExpression() ")"
}

void distinct() #DistinctExp : { }
{
	<DISTINCT> "(" pathExpression() ")"
}

TOKEN_MGR_DECLS:
{
      /** Holds the last value computed by a constant token. */
    Object literalValue;
    
      /** Holds the last string literal parsed. */
    private StringBuffer stringBuffer;

      /** Converts an escape sequence into a character value. */
    private char escapeChar()
    {
        int ofs = image.length() - 1;
        switch ( image.charAt(ofs) ) {
            case 'n':   return '\n';
            case 'r':   return '\r';
            case 't':   return '\t';
            case 'b':   return '\b';
            case 'f':   return '\f';
            case '\\':  return '\\';
            case '\'':  return '\'';
            case '\"':  return '\"';
        }

          // Otherwise, it's an octal number.  Find the backslash and convert.
        while ( image.charAt(--ofs) != '\\' )
          {}
        int value = 0;
        while ( ++ofs < image.length() )
            value = (value << 3) | (image.charAt(ofs) - '0');
        return (char) value;
    }

    private Object makeInt()
    {
        Object  result;
        String  s = image.toString();
        int     base = 10;

        if ( s.charAt(0) == '0' )
            base = (s.length() > 1 && (s.charAt(1) == 'x' || s.charAt(1) == 'X'))? 16 : 8;
        if ( base == 16 )
            s = s.substring(2); // Trim the 0x off the front
        switch ( s.charAt(s.length()-1) ) {
            case 'l': case 'L':
                result = Long.valueOf( s.substring(0,s.length()-1), base );
                break;

            case 'h': case 'H':
                result = new BigInteger( s.substring(0,s.length()-1), base );
                break;

            default:
                result = Integer.valueOf( s, base );
                break;
        }
        return result;
    }

    private Object makeFloat()
    {
        String s = image.toString();
        switch ( s.charAt(s.length()-1) ) {
            case 'f': case 'F':
                return Float.valueOf( s );

            case 'b': case 'B':
                return new BigDecimal( s.substring(0,s.length()-1) );

            case 'd': case 'D':
            default:
                return Double.valueOf( s );
        }
    }
}

SKIP :
{
  " "
| "\t"
| "\n"
| "\r"
}

TOKEN : {
	<NULL: "null" | "NULL" >
    |   <TRUE: "true" | "TRUE" >
    |   <FALSE: "false" | "FALSE" >
}

TOKEN : /* aggregates */
{
	<AVG: "avg" >
	|	<MIN: "min" >
	|	<MAX: "max" >
	|	<SUM: "sum" >
	|	<COUNT: "count" >
	|	<DISTINCT: "distinct">
}

TOKEN : /* exists */
{
    <EXISTS: "exists">
    | <NOT_EXISTS: "not exists">
}

TOKEN : /* root object of a query */
{
    <SELF: "self">
}

TOKEN : /* functions returning strings */
{
	<CONCAT: "concat" >
	|	<SUBSTRING: "substring" >
	|	<TRIM: "trim" >
	|	<LOWER: "lower" >
	|	<UPPER: "upper" >
}

TOKEN : /* functions returning numerics */
{
	<LENGTH: "length" >
	|	<LOCATE: "locate" >
	|	<ABS: "abs" >
	|	<SQRT: "sqrt" >
	|	<MOD: "mod" >
}

TOKEN : /* functions returning datetime */
{
	<CURRENT_DATE: "currentDate" >
	|	<CURRENT_TIME: "currentTime" >
	|	<CURRENT_TIMESTAMP: "currentTimestamp" | "now" >
}

/*
    Data/time parts extracting functions' names.
    MUST be in sync with enum ExtractExp.DateTimePart.
*/
TOKEN :
{
    <YEAR: "year">
    | <MONTH: "month">
    | <WEEK: "week">
    | <DAY_OF_YEAR: "dayOfYear">
    | <DAY: "day">
    | <DAY_OF_MONTH: "dayOfMonth">
    | <DAY_OF_WEEK: "dayOfWeek">
    | <HOUR: "hour">
    | <MINUTE: "minute">
    | <SECOND: "second">
}

/*
Special operations
*/
TOKEN :
{
    <FUNCTION: "fn" >
	|
	<OPERATOR: "op" >
	|
	<AGGREGATE: "agg" >
}

void namedParameter() :{
	Token t;
}
{
	    // "pathToken" allows parameter names that match the names of functions, like "$min" or "$count"

	    // binding positional parameters as we go
	    LOOKAHEAD({ parameters != null }) "$" t = pathToken() { jjtree.pushNode(boundParameter(t.image)); }
	|
	    "$" t = pathToken() { jjtThis.setValue(t.image); } #NamedParameterExp(0)
}

void pathExpression() : {
   Token t;
}
{
             t = <PROPERTY_PATH> { QLParserHelper.parsePath(jjtThis, t.image); } #ObjPathExp(0)
   |
     "obj:"  t = pathToken() { QLParserHelper.parsePath(jjtThis, t.image); } #ObjPathExp(0)
   |
     "db:"   t = pathToken() { QLParserHelper.parsePath(jjtThis, t.image); } #DbPathExp(0)
   |
     "enum:" t = pathToken() { jjtThis.setEnumValue(t.image); } #EnumExp(0)
   |
     "dbid:" t = pathToken() { QLParserHelper.parsePath(jjtThis, t.image); } #DbIdPathExp(0)
}

TOKEN : {
    <ASTERISK: "*">
}

// this rule returns single token that could be used as a path definition
Token pathToken() : {
    Token t ;
}
{
    (
      t = <PROPERTY_PATH>

    | t = <AVG>
    | t = <MIN>
    | t = <MAX>
    | t = <SUM>
    | t = <COUNT>
    | t = <DISTINCT>
    | t = <SELF>

    | t = <CONCAT>
    | t = <SUBSTRING>
    | t = <TRIM>
    | t = <LOWER>
    | t = <UPPER>

    | t = <LENGTH>
    | t = <LOCATE>
    | t = <ABS>
    | t = <SQRT>
    | t = <MOD>

    | t = <CURRENT_DATE>
    | t = <CURRENT_TIME>
    | t = <CURRENT_TIMESTAMP>

    | t = <YEAR>
    | t = <MONTH>
    | t = <DAY>
    | t = <HOUR>
    | t = <MINUTE>
    | t = <SECOND>
    | t = <DAY_OF_MONTH>
    | t = <DAY_OF_WEEK>
    | t = <DAY_OF_YEAR>

    )
    {return t;}
}

TOKEN : {
	<PROPERTY_PATH: <IDENTIFIER> ( "." <IDENTIFIER>) *>
}

TOKEN :
{
  < IDENTIFIER: <LETTER> (<LETTER>|<DIGIT>|<DOLLAR_SIGN>)* (["#"]<LETTER> (<LETTER>|<DIGIT>|<DOLLAR_SIGN>)*)? (["+"])? >
|
  < #LETTER: ["_","a"-"z","A"-"Z"] >
|
  < #DIGIT: ["0"-"9"] >
|
  < #DOLLAR_SIGN: ["$"] >
}

/**
 * Quoted Strings, whose object value is stored in the token manager's
 * "literalValue" field. Both single and double qoutes are allowed 
 */
MORE:
{
    "'"  { stringBuffer = new StringBuffer(); }: WithinSingleQuoteLiteral
 |
    "\""  { stringBuffer = new StringBuffer(); }: WithinDoubleQuoteLiteral
}

<WithinSingleQuoteLiteral> MORE:
{
	< ESC: "\\" ( ["n","r","t","b","f","\\","'","`","\""]
                | (["0"-"3"])? ["0"-"7"] (["0"-"7"])?
                )
    >
        { stringBuffer.append( escapeChar() ); }
 |
    < (~["'","\\"]) >
        { stringBuffer.append( image.charAt(image.length()-1) ); }
}

<WithinSingleQuoteLiteral> TOKEN :
{
    <SINGLE_QUOTED_STRING: "'">
        { literalValue = stringBuffer.toString(); }
        : DEFAULT
}

<WithinDoubleQuoteLiteral> MORE :
{
    < STRING_ESC: <ESC> >
        { stringBuffer.append( escapeChar() ); }
 |
    < (~["\"","\\"]) >
        { stringBuffer.append( image.charAt(image.length()-1) ); }
}

<WithinDoubleQuoteLiteral> TOKEN:
{
    <DOUBLE_QUOTED_STRING: "\"">
        { literalValue = stringBuffer.toString(); }
        : DEFAULT
}

/**
 * Integer or real Numeric literal, whose object value is stored in the token manager's
 * "literalValue" field.
 */
TOKEN:
{
    < INT_LITERAL:
        ( "0" (["0"-"7"])* | ["1"-"9"] (["0"-"9"])* | "0" ["x","X"] (["0"-"9","a"-"f","A"-"F"])+ )
        (["l","L","h","H"])?
    >
        { literalValue = makeInt(); }
 |
    < FLOAT_LITERAL:
        ( <DEC_FLT> (<EXPONENT>)? (<FLT_SUFF>)?
        | <DEC_DIGITS> <EXPONENT> (<FLT_SUFF>)?
        | <DEC_DIGITS> <FLT_SUFF>
        )
    >
        { literalValue = makeFloat(); }

 |  < #DEC_FLT: (["0"-"9"])+ "." (["0"-"9"])* | "." (["0"-"9"])+ >
 |  < #DEC_DIGITS: (["0"-"9"])+ >
 |  < #EXPONENT: ["e","E"] (["+","-"])? (["0"-"9"])+ >
 |  < #FLT_SUFF: ["d","D","f","F","b","B"] >
}
