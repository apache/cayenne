options {
	
	MULTI = true;
	NODE_DEFAULT_VOID = true;
	NODE_PREFIX = "";
	NODE_FACTORY = "org.apache.cayenne.ql.QLParser";
	
	STATIC = false;
	DEBUG_PARSER = false;
	DEBUG_LOOKAHEAD = false;
	DEBUG_TOKEN_MANAGER = false;
	JAVA_UNICODE_ESCAPE = true;
	UNICODE_INPUT = true;
}

PARSER_BEGIN(QLParser)
