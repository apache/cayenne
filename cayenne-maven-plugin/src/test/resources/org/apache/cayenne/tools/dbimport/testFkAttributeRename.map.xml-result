<dataMap xmlns="http://cayenne.apache.org/schema/14/dataMap"
	 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	 xsi:schemaLocation="http://cayenne.apache.org/schema/14/dataMap https://cayenne.apache.org/schema/14/dataMap.xsd">
	<dbEntity name="CHILD" schema="SCHEMA_01">
		<dbAttribute name="PAR" type="INTEGER" length="10"/>
		<dbAttribute name="id" type="INTEGER" length="10"/>
	</dbEntity>
	<dbEntity name="PARENT" schema="SCHEMA_01">
		<dbAttribute name="id" type="INTEGER" primaryKey="true" mandatory="true" length="10"/>
	</dbEntity>
	<objEntity name="Child" className="Child" dbEntityName="CHILD"/>
	<objEntity name="Parent" className="Parent" dbEntityName="PARENT"/>
	<dbRelationship name="par" source="CHILD" target="PARENT">
		<dbAttributePair source="PAR" target="id"/>
	</dbRelationship>
	<dbRelationship name="children" source="PARENT" target="CHILD" toMany="true">
		<dbAttributePair source="id" target="PAR"/>
	</dbRelationship>
	<objRelationship name="par1" source="Child" target="Parent" deleteRule="nullify" dbRelationshipPath="par"/>
	<objRelationship name="children" source="Parent" target="Child" deleteRule="deny" dbRelationshipPath="children"/>
</dataMap>
