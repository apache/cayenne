<!-- Bundle descriptor read by maven-remote-resources-plugin:process in the other modules. Maintained by hand instead
     of being generated by the "bundle" goal, so that this module does not depend on the plugin, which in turn depends
     on this module (see the plugin's pluginManagement entry in the root pom) -->
<remoteResourcesBundle xsi:schemaLocation="http://maven.apache.org/remote-resources/1.2.0 https://maven.apache.org/xsd/remote-resources-1.2.0.xsd"
    xmlns="http://maven.apache.org/remote-resources/1.2.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <remoteResources>
    <remoteResource>META-INF/cayenne/LICENSE.txt.vm</remoteResource>
    <remoteResource>META-INF/cayenne/NOTICE.txt.vm</remoteResource>
  </remoteResources>
  <sourceEncoding>UTF-8</sourceEncoding>
</remoteResourcesBundle>
