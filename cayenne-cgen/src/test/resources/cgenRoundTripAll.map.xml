<!-- Saved in another form: "ALL", trailing "/", unsorted and missing excludes, default path of another template -->
<dataMap xmlns="http://cayenne.apache.org/schema/15/dataMap"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://cayenne.apache.org/schema/15/dataMap https://cayenne.apache.org/schema/15/dataMap.xsd">
    <embeddable className="org.example.Address"/>
    <embeddable className="org.example.Phone"/>
    <objEntity name="Artist" className="org.example.Artist"/>
    <objEntity name="Gallery" className="org.example.Gallery"/>
    <objEntity name="Painting" className="org.example.Painting"/>
    <cgen>
        <name>Custom</name>
        <excludeEntities>Painting,Removed,Artist</excludeEntities>
        <excludeEmbeddables>org.example.Phone,org.example.Removed</excludeEmbeddables>
        <destDir>../java/</destDir>
        <mode>ALL</mode>
        <template><![CDATA[subclass template]]></template>
        <superTemplate><![CDATA[superclass template]]></superTemplate>
        <embeddableTemplate><![CDATA[embeddable subclass template]]></embeddableTemplate>
        <embeddableSuperTemplate><![CDATA[embeddable superclass template]]></embeddableSuperTemplate>
        <dataMapTemplate><![CDATA[datamap subclass template]]></dataMapTemplate>
        <dataMapSuperTemplate><![CDATA[datamap superclass template]]></dataMapSuperTemplate>
        <outputPattern>*.groovy</outputPattern>
        <makePairs>false</makePairs>
        <usePkgPath>false</usePkgPath>
        <overwrite>true</overwrite>
        <createPropertyNames>true</createPropertyNames>
        <superPkg>org.example.auto</superPkg>
        <createPKProperties>false</createPKProperties>
        <externalToolConfig>tools.properties</externalToolConfig>
    </cgen>
    <cgen>
        <template>templates/v4_1/superclass.vm</template>
    </cgen>
</dataMap>
