          xsi:schemaLocation="http://cayenne.apache.org/schema/13/modelMap https://cayenne.apache.org/schema/13/modelMap.xsd"
          project-version="13">
    <obj-entity name="Artist" className="org.example.Artist">
    </obj-entity>
    <cgen xmlns="http://cayenne.apache.org/schema/13/cgen">
        <name>Default</name>
        <destDir>../java</destDir>
        <mode>entity</mode>
        <embeddableSuperTemplate><![CDATA[custom embeddable superclass template]]></embeddableSuperTemplate>
